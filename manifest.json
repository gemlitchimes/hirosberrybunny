{
  "manifest_version": 3,
  "name": "Hiro's Berry Bunny — AI Studio",
  "short_name": "Berry Bunny",
  "version": "1.0.0",
  "description": "Giao diện bánh dâu sữa cho Google AI Studio: nền caro hồng, bé thỏ ôm dâu, nút shortcake và intro Hiro's Berry Bunny.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hiro's Berry Bunny",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "css": ["fonts.css", "theme.css"],
      "js": ["chime.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*", "img/*"], "matches": ["https://aistudio.google.com/*"] }
  ]
}
